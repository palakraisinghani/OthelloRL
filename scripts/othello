#!/usr/bin/env bash
# Launcher for the `othello` terminal game; install with:  ln -sf "$PWD/scripts/othello" ~/.local/bin/othello
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PY="$REPO/.venv/bin/python"; [ -x "$PY" ] || PY=python3   # project venv (has torch) if present
PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m othello "$@"
